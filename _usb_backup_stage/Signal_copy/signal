import { Hyperliquid, candle } from '@nktkas/hyperliquid';

// Initialize the SDK. No private key is passed as we are strictly signaling, not trading.
const hl = new Hyperliquid();
const SYMBOL = 'BTC'; 
const INTERVAL = '1m'; 

// --- Helper Functions ---

/**
 * Calculates the Stochastic Oscillator %K and %D.
 * Formula: %K = ((Current Close - Lowest Low) / (Highest High - Lowest Low)) * 100
 * %D = Simple Moving Average of %K
 */
function calculateStochastic(candles, kPeriod = 5, dPeriod = 3, slowing = 3) {
    if (candles.length < kPeriod + slowing) return null;

    let kValues = [];
    for (let i = 0; i < candles.length - slowing + 1; i++) {
        let highestHigh = -Infinity;
        let lowestLow = Infinity;
        
        // Find highest high and lowest low in the K period window
        for (let j = 0; j < kPeriod; j++) {
            const c = candles[i + j];
            if (c.high > highestHigh) highestHigh = c.high;
            if (c.low < lowestLow) lowestLow = c.low;
        }

        const currentClose = candles[i + kPeriod - 1].close;
        const denominator = highestHigh - lowestLow;
        let rawK = denominator === 0 ? 0 : ((currentClose - lowestLow) / denominator) * 100;
        kValues.push(rawK);
    }

    // Apply slowing to get %K
    let slowKValues = [];
    for (let i = 0; i <= kValues.length - slowing; i++) {
        let sum = 0;
        for (let j = 0; j < slowing; j++) {
            sum += kValues[i + j];
        }
        slowKValues.push(sum / slowing);
    }

    // Calculate %D (Moving Average of SlowK)
    if (slowKValues.length < dPeriod) return null;
    let dValues = [];
    for (let i = 0; i <= slowKValues.length - dPeriod; i++) {
        let sum = 0;
        for (let j = 0; j < dPeriod; j++) {
            sum += slowKValues[i + j];
        }
        dValues.push(sum / dPeriod);
    }

    return {
        K: slowKValues[slowKValues.length - 1],
        prevK: slowKValues[slowKValues.length - 2],
        D: dValues[dValues.length - 1]
    };
}

/**
 * Calculates the Average True Range (ATR)
 */
function calculateATR(candles, period = 14) {
    if (candles.length < period) return null;
    let trSum = 0;

    for (let i = 1; i < candles.length; i++) {
        const prevClose = candles[i - 1].close;
        const currentHigh = candles[i].high;
        const currentLow = candles[i].low;
        const currentClose = candles[i].close;

        const hl = currentHigh - currentLow;
        const hc = Math.abs(currentHigh - prevClose);
        const lc = Math.abs(currentLow - prevClose);
        const tr = Math.max(hl, hc, lc);
        trSum += tr;
    }

    return trSum / period;
}

// --- Main Signal Logic ---

async function checkTradingSignals() {
    try {
        // Fetch historical candlestick data (e.g., 100 candles for indicator history)
        const candles = await hl.info.getCandles(SYMBOL, INTERVAL, 100);
        
        if (candles.length < 50) return; // Wait for enough data

        // Split today and yesterday
        const now = new Date();
        const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() / 1000;
        
        const todaysCandles = candles.filter(c => c.t >= startOfToday);
        const yesterdaysCandles = candles.filter(c => c.t < startOfToday);

        if (yesterdaysCandles.length === 0 || todaysCandles.length < 2) return;

        // 1. Calculate Yesterday's Lowest Range
        let yesterdaysLowestRange = Infinity;
        for (let c of yesterdaysCandles) {
            const range = c.high - c.low;
            if (range < yesterdaysLowestRange) yesterdaysLowestRange = range;
        }

        // 2. Calculate ATR (using standard 14 periods)
        const atr = calculateATR(candles, 14);
        
        // 3. Calculate Stochastic (5, 3, 3)
        const stoch = calculateStochastic(candles, 5, 3, 3);

        if (!atr || !stoch) return;

        console.log(`[${new Date().toLocaleTimeString()}] ATR: ${atr.toFixed(4)} | Yest. Lowest Range: ${yesterdaysLowestRange.toFixed(4)} | Stoch %K: ${stoch.K.toFixed(2)}`);

        // 4. Signal Conditions Evaluation
        // - ATR is below yesterday's lowest range
        // - Stochastic %K crossed from below 50 to above 50
        const isAtrCondition = atr < yesterdaysLowestRange;
        const isStochCross = stoch.prevK < 50 && stoch.K >= 50;

        if (isAtrCondition && isStochCross) {
            console.log(`\n=========================================`);
            console.log(`🚨 BUY SIGNAL DETECTED for ${SYMBOL}`);
            console.log(`ATR ${atr.toFixed(4)} < Yest. Lowest Range ${yesterdaysLowestRange.toFixed(4)}`);
            console.log(`Stochastic %K crossed to ${stoch.K.toFixed(2)} (Prev: ${stoch.prevK.toFixed(2)})`);
            console.log(`=========================================\n`);
        }

    } catch (error) {
        console.error("Error fetching or processing data:", error);
    }
}

// Run polling every 1 minute
setInterval(checkTradingSignals, 60 * 1000);

// Run immediately on start
checkTradingSignals();
